# syntax=docker/dockerfile:1

# ---- Stage 1: base with pinned inference-only dependencies -----------------
FROM python:3.11-slim AS base

WORKDIR /app

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Only inference dependencies (torch/torchvision for the model + transforms,
# fastapi/uvicorn for the API, Pillow for image decoding). No training-only
# libraries such as tensorboard.
COPY requirements/serve.txt ./requirements/serve.txt
RUN pip install --no-cache-dir -r requirements/serve.txt

# ---- Stage 2: serving runtime -----------------------------------------------
FROM base AS serving

COPY src/serve.py src/model.py src/dataset.py src/__init__.py ./src/

ENV PYTHONUNBUFFERED=1 \
    CHECKPOINT_DIR=/app/checkpoints \
    MODEL_NAME=classifier_v1.pt

# Mount point for the (read-only, in Kubernetes) checkpoint volume.
RUN mkdir -p /app/checkpoints

# Run as a non-root user.
RUN useradd --create-home --uid 1000 server && \
    chown -R server:server /app
USER server

EXPOSE 8080

# Uses the stdlib instead of curl to avoid adding extra packages to the slim image.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8080/health', timeout=3).status == 200 else 1)"

CMD ["uvicorn", "serve:app", "--app-dir", "src", "--host", "0.0.0.0", "--port", "8080"]

